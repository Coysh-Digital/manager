####################################################################################################
# Manager
#
# Every variable here is documented in docs/env.md, including which are mandatory in production and
# what `php artisan manager:doctor` checks about them.
####################################################################################################

APP_NAME=Manager
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# The canonical, externally reachable URL. Cookie security and connector callbacks are validated
# against this, so it must match what browsers and connectors actually use.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ------------------------------------------------------------------------------------
# Postgres in every environment. The audit log relies on a trigger and on privileges that are not
# portable to SQLite, so tests run against Postgres too.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

# --- Redis ---------------------------------------------------------------------------------------
# Backs the cache, the queue, and the connector replay-nonce store. If Redis is unreachable,
# signature verification rejects rather than passes: replay protection fails closed.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Sessions live in the database so they can be listed and revoked individually.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Manager ---------------------------------------------------------------------------------
# Seconds an enrolment code stays valid. Short by design: it is a bearer secret until consumed.
MANAGER_ENROLMENT_TTL=900

# Seconds either side of platform time that a connector request timestamp may fall. Widening this
# widens the replay window the nonce store has to remember; the two move together.
MANAGER_TIMESTAMP_TOLERANCE=120

# Minutes a password confirmation counts as "recent" for sensitive actions.
MANAGER_RECENT_AUTH_MINUTES=15

# Comma-separated trusted proxies, or a single CIDR. Never "*" — see docs/reverse-proxy.md.
MANAGER_TRUSTED_PROXIES=

# Opt-in diagnostics. Off by default, carries no site content or secrets, and can be turned off
# again from settings at any time.
MANAGER_DIAGNOSTICS_ENABLED=false

# --- Site backups ----------------------------------------------------------------------------
# Generate with: php artisan manager:backups:keygen
#
# X25519, and separate from the signing keypair on purpose: one keypair used for both signing and
# encryption weakens both. Connectors seal each artifact's key to the public half.
#
# Whoever holds the secret half can read every stored backup, so this is NOT end-to-end encryption
# and docs/backup.md does not claim it is. Back it up somewhere other than beside the backups —
# losing it makes every stored artifact permanently unreadable, deliberately with no recovery path.
MANAGER_BACKUP_PUBLIC_KEY=
MANAGER_BACKUP_SECRET_KEY=

# Where artifacts go. The local default works, but it is a poor place for the only copy of a
# customer's database; point this at an S3-compatible bucket with credentials scoped to it alone.
MANAGER_BACKUP_DRIVER=local
MANAGER_BACKUP_DISK=backups
MANAGER_BACKUP_S3_BUCKET=
MANAGER_BACKUP_S3_KEY=
MANAGER_BACKUP_S3_SECRET=
MANAGER_BACKUP_S3_REGION=
MANAGER_BACKUP_S3_ENDPOINT=
MANAGER_BACKUP_S3_PATH_STYLE=false

# --- Mail ----------------------------------------------------------------------------------------
# Set this up. Password resets and invitations are how anybody other than the first account gets in,
# and `log` writes them to storage/logs instead of sending them — so nothing arrives and nothing
# reports a problem. `manager:doctor` warns while this is unset.
#
# MAIL_MAILER: smtp | postmark | resend | ses | sendmail | log
# The API transports need no host or port, just their key — see docs/env.md.
#
# Prove it works:  php artisan manager:mail-test you@example.org
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="manager@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage ------------------------------------------------------------------------------
# Used for backups from Phase 3. Any S3-compatible endpoint, including MinIO.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
