# Static analysis for the Cloud overlay.
#
# Run from the core checkout, not the package, and for the same reason its tests are: the overlay
# implements the core's contracts and binds into its container, so analysing it anywhere the core is
# not a bootable Laravel application would check it against a fiction. Larastan needs a real app to
# resolve a facade or a model query at all.
#
# A companion file to phpunit.cloud.xml. Both are written by the console branch and neither ships to
# production, where nothing analyses and nothing tests.
#
#     ddev exec vendor/bin/phpstan analyse -c phpstan.cloud.neon
#
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # The same level the core holds itself to. A package that replaces implementations inside the
    # core's container has no business being checked less strictly than what it replaces.
    level: 6

    paths:
        - cloud/src

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Larastan resolves view names by scanning the application's view paths, which it reads from
        # config. The overlay's views live behind a `cloud::` namespace registered at runtime by
        # loadViewsFrom(), so static analysis cannot see them and reports every one as an invalid
        # view-string. Narrowed to that namespace, so an ordinary typo in a core view name is still
        # caught.
        -
            message: '#expects view-string\|null, string given#'
            path: cloud/src/Http/Controllers/*.php
